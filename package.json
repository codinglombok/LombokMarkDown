{
  "name": "lombokmarkdown",
  "version": "2.0.0",
  "description": "CommonMark 0.31.2 and GitHub Flavored Markdown to HTML with safe defaults, AST, metadata and table of contents. Zero dependencies. Part of the Lombok Ecosystem.",
  "keywords": [
    "markdown",
    "commonmark",
    "gfm",
    "markdown-to-html",
    "parser",
    "ast",
    "toc",
    "zero-dependency",
    "lombok-ecosystem"
  ],
  "license": "Apache-2.0",
  "author": "codinglombok (https://github.com/codinglombok)",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md",
    "UPGRADE.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "lint": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest --run",
    "coverage": "vitest --run --coverage",
    "fuzz": "npm run build && tsx tests/fuzz/markdown.fuzz.ts",
    "vectors": "python3 vectors/build_vectors.py",
    "doctor": "bash scripts/lombok-doctor.sh LombokMarkDown",
    "check": "npm run lint && npm run coverage && npm run build && npm run doctor"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "commonmark-spec": "0.31.2",
    "lombokfuzzer": "^0.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codinglombok/LombokMarkDown.git"
  },
  "homepage": "https://codinglombok.github.io/LombokMarkDown",
  "bugs": {
    "url": "https://github.com/codinglombok/LombokMarkDown/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
